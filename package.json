{
  "name": "frontend",
  "version": "0.1.0",
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "start": "modern start",
    "serve": "modern serve",
    "new": "modern new",
    "lint": "biome check",
    "prepare": "simple-git-hooks",
    "upgrade": "modern upgrade"
  },
  "engines": {
    "node": ">=16.18.1"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@modern-js/plugin-bff": "2.68.19",
    "@modern-js/plugin-tailwindcss": "2.68.19",
    "@modern-js/runtime": "2.68.19",
    "@tanstack/react-query": "^5.90.7",
    "antd": "^5.28.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.0",
    "react-hook-form-persist": "^3.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@modern-js/app-tools": "2.68.19",
    "@modern-js/tsconfig": "2.68.19",
    "@types/jest": "~29.2.4",
    "@types/node": "~18.11.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "~18.3.1",
    "lint-staged": "~15.4.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "~3.4.14",
    "ts-node": "~10.8.1",
    "tsconfig-paths": "~3.14.1",
    "typescript": "~5.7.3"
  }
}
